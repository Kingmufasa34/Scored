# ─────────────────────────────────────────────────────────────────────────────
# Scored — Delay Repay agent configuration
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gmail (OAuth) ────────────────────────────────────────────────────────────
# Path to the OAuth client secret from the Google Cloud Console.
# CLI flow (`npm run auth:gmail`) uses a "Desktop app" client.
# WEB flow (the in-app "Continue with Google" button) uses a "Web application"
# client whose Authorised redirect URI is <your app origin>/auth/google/callback
# (e.g. http://localhost:3000/auth/google/callback). Either put that client in
# credentials.json, or set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below.
GMAIL_CREDENTIALS_PATH=./credentials.json
# Where the agent stores the token after sign-in.
GMAIL_TOKEN_PATH=./gmail-token.json
# Optional: Google OAuth web client for the in-app sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail search query used to find ticket / booking-confirmation emails.
# Tune this to match the senders you actually receive tickets from.
GMAIL_QUERY=from:(auto-confirm@trainline.com OR no-reply@gwr.com OR nationalrail.co.uk) newer_than:35d
# Max messages to scan per run.
GMAIL_MAX_RESULTS=25

# ── Realtime Trains API (https://api.rtt.io) ─────────────────────────────────
# Register for the free personal Pull API and put your credentials here.
RTT_USERNAME=
RTT_PASSWORD=

# ── Behaviour ────────────────────────────────────────────────────────────────
# prepare = build fully pre-filled claims for you to review (default, safe)
# auto    = also drive the operator's web form via Playwright (opt-in, brittle)
SUBMIT_MODE=prepare
# Minimum delay (minutes) to bother preparing a claim. Operator scheme still
# decides eligibility/percentage; this is just a floor to reduce noise.
MIN_DELAY_MINUTES=15
# Where prepared claims and processed-state are written.
DATA_DIR=./data
PREPARED_DIR=./prepared-claims
# Set to 1 to see verbose logging.
DEBUG=0
